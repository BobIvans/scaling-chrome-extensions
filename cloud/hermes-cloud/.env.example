# Generate a long random secret and store the real value in the cloud secret manager.
API_SERVER_KEY=replace-with-random-64-hex

# Replace EXTENSION_ID after installing/loading OCC.
API_SERVER_CORS_ORIGINS=chrome-extension://EXTENSION_ID

