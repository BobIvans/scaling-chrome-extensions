{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PortableSkill",
  "description": "Proposed application contract v1; no vendor API claim",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "skill.v1"
    },
    "skill_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "code_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "recording_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "input_contract_ref": {
      "type": "string",
      "minLength": 1
    },
    "output_contract_ref": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "properties": {
        "grant_ref": {
          "type": "string",
          "minLength": 1
        },
        "scope_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "effect_kind": {
          "type": "string",
          "enum": [
            "LOCAL_READ",
            "LOCAL_WRITE",
            "AI_MESSAGE",
            "DEVELOPMENT_REQUEST"
          ]
        },
        "repo_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "target_binding_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "grant_ref",
        "scope_digest",
        "effect_kind",
        "repo_ref",
        "target_binding_ref"
      ],
      "additionalProperties": false
    },
    "dependency_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step_id": {
            "type": "string",
            "minLength": 1
          },
          "capability_ref": {
            "type": "string",
            "minLength": 1
          },
          "capability_version": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "input_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "expected_output_criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "effect_kind": {
            "type": "string",
            "enum": [
              "LOCAL_READ",
              "LOCAL_WRITE",
              "AI_MESSAGE",
              "DEVELOPMENT_REQUEST"
            ]
          }
        },
        "required": [
          "step_id",
          "capability_ref",
          "capability_version",
          "depends_on",
          "input_refs",
          "expected_output_criteria",
          "effect_kind"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "recovery_contract_ref": {
      "type": "string",
      "minLength": 1
    },
    "credential_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "failure_capsule_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "qualification_receipt_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "state": {
      "type": "string",
      "enum": [
        "CANDIDATE",
        "QUALIFIED",
        "STALE",
        "RETIRED"
      ]
    }
  },
  "required": [
    "schema_version",
    "skill_id",
    "version",
    "code_digest",
    "recording_refs",
    "input_contract_ref",
    "output_contract_ref",
    "scope",
    "dependency_refs",
    "preconditions",
    "steps",
    "invariants",
    "recovery_contract_ref",
    "credential_refs",
    "failure_capsule_refs",
    "qualification_receipt_refs",
    "state"
  ],
  "additionalProperties": false
}
