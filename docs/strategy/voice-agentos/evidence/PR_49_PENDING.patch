+            payload=json.loads(row['payload'])
+            if row['state']=='STALE' or any(self.dependency_versions().get(k)!=v for k,v in payload['dependencies'].items()):
+                raise ValueError('ACTION_SKILL_DEPENDENCY_MISMATCH')
