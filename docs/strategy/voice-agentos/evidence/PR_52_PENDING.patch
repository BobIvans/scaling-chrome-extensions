+            "output_root": str(work / "runs"),
+            "timeout_seconds": 120,
+        }
+        templates[pack] = {"kind": "studious_research", "research_profile": pack}
+    policy = {
+        "schema": "occ.automation-policy.v1",
+        "max_parallel": 1,
+        "money_budget": 0,
