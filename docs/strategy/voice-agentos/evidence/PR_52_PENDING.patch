+        "status": "OFFLINE_INTEGRATION_PASS",
+        "studious_commit": actual,
+        "sce_commit": sce_commit,
+        "origin": "OFFLINE_FIXTURE",
+        "packs": len(payloads),
+        "campaigns": len(jobs),
+        "records": sum(j["records"] for j in jobs),
+        "useful_calls": sum(j["useful_calls"] for j in jobs),
+        "exact_repeat_pairs": 5,
