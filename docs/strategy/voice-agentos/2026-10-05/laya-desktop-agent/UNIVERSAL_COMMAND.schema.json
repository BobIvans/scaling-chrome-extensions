{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/voice-agentos/UniversalCommand.schema.json",
  "title": "UniversalCommand",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "raw_text",
    "goal",
    "mode",
    "source_hints",
    "target_hints",
    "effect_scope",
    "acceptance",
    "budgets"
  ],
  "properties": {
    "schema": {
      "const": "voice-agentos.universal-command.v1"
    },
    "raw_text": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "OBSERVE",
        "PREVIEW",
        "RUN_REGISTERED",
        "LONG_HORIZON",
        "WAIT_AND_RESUME",
        "RND_CAMPAIGN"
      ]
    },
    "source_hints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "target_hints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "repo_hints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "context_hints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prohibitions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "effect_scope": {
      "type": "array",
      "items": {
        "enum": [
          "READ",
          "LOCAL_WRITE",
          "LOCAL_PROCESS",
          "BROWSER_WRITE",
          "GIT_WRITE",
          "GITHUB_WRITE",
          "MESSAGE_SEND",
          "INSTALL_UPDATE"
        ]
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": true
    },
    "parallelism": {
      "type": "object",
      "additionalProperties": true
    },
    "provider_preferences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "self_improvement": {
      "type": "object",
      "properties": {
        "allow_gap_resolution": {
          "type": "boolean"
        },
        "allow_tool_build": {
          "type": "boolean"
        },
        "allow_pr_creation": {
          "type": "boolean"
        },
        "allow_merge": {
          "type": "boolean"
        },
        "allow_install_update": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "human_interrupt_policy": {
      "enum": [
        "ASK_ON_BLOCKER",
        "ASK_BEFORE_EXTERNAL_WRITE",
        "MINIMIZE_INTERRUPTIONS",
        "OBSERVE_ONLY"
      ]
    }
  }
}
