{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed PR005 Native request (adapter fields, requestId wrapper stripped)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "repository",
    "snapshotId",
    "action"
  ],
  "properties": {
    "type": {
      "const": "durable.repo.coverage"
    },
    "repository": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"
    },
    "snapshotId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "action": {
      "enum": [
        "SUMMARY",
        "PAGE"
      ]
    },
    "query": {
      "enum": [
        "ALL",
        "GAPS"
      ]
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "cursor": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "snapshotId",
            "classifierVersion",
            "query",
            "afterOrdinal"
          ],
          "properties": {
            "snapshotId": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "classifierVersion": {
              "const": "utf8-controls-strict-lfs3.v1"
            },
            "query": {
              "enum": [
                "ALL",
                "GAPS"
              ]
            },
            "afterOrdinal": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "SUMMARY"
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "cursor"
              ]
            },
            {
              "required": [
                "limit"
              ]
            },
            {
              "required": [
                "query"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "PAGE"
          }
        }
      },
      "then": {
        "required": [
          "query",
          "limit",
          "cursor"
        ]
      }
    }
  ]
}
