{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "type",
        "repository",
        "snapshotId",
        "action"
      ],
      "properties": {
        "type": {
          "const": "durable.repo.manifest"
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
        },
        "snapshotId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "action": {
          "const": "INFO"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "type",
        "repository",
        "snapshotId",
        "action"
      ],
      "properties": {
        "type": {
          "const": "durable.repo.manifest"
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
        },
        "snapshotId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "action": {
          "const": "ENTRIES"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "type",
        "repository",
        "snapshotId",
        "action"
      ],
      "properties": {
        "type": {
          "const": "durable.repo.manifest"
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
        },
        "snapshotId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "action": {
          "const": "PARTS"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "fileOrdinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    }
  ]
}
