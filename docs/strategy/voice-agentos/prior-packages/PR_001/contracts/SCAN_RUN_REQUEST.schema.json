{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed native scan-run action request",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "durable.repo.scanRun"
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
        },
        "action": {
          "const": "START"
        },
        "intentKey": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        }
      },
      "required": [
        "type",
        "repository",
        "action",
        "intentKey"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "durable.repo.scanRun"
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
        },
        "action": {
          "const": "STATUS"
        },
        "runId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "type",
        "repository",
        "action"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "durable.repo.scanRun"
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
        },
        "action": {
          "const": "STEP"
        },
        "runId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expectedCursor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "repository",
        "action",
        "runId",
        "expectedCursor",
        "expectedRevision"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "durable.repo.scanRun"
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
        },
        "action": {
          "const": "PAUSE"
        },
        "runId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "repository",
        "action",
        "runId",
        "expectedRevision"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "durable.repo.scanRun"
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
        },
        "action": {
          "const": "CONTINUE"
        },
        "runId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "repository",
        "action",
        "runId",
        "expectedRevision"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "durable.repo.scanRun"
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
        },
        "action": {
          "const": "CANCEL"
        },
        "runId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "repository",
        "action",
        "runId",
        "expectedRevision"
      ],
      "additionalProperties": false
    }
  ]
}
