{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QualificationReceipt",
  "description": "Proposed application contract v1; no vendor API claim",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "qualification.v1"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "code_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dependency_digests": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "minItems": 0
    },
    "environment_ref": {
      "type": "string",
      "minLength": 1
    },
    "qualified_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "case_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "input_corpus_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "scope": {
      "type": "string",
      "enum": [
        "FIXTURE",
        "WINDOWS_DEVICE",
        "SELECTED_UI",
        "SKILL_DEVICE"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "STALE",
        "UNSUPPORTED"
      ]
    },
    "observed_limits_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "receipt_id",
    "subject_ref",
    "code_digest",
    "dependency_digests",
    "environment_ref",
    "qualified_capabilities",
    "case_ids",
    "input_corpus_digest",
    "evidence_refs",
    "scope",
    "status",
    "observed_limits_ref"
  ],
  "additionalProperties": false
}
