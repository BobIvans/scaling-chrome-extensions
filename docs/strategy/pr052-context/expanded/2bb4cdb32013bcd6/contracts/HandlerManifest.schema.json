{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sce-studious:proposed:HandlerManifest:v1",
  "title": "HandlerManifest proposed v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "handler_id": {
      "type": "string",
      "minLength": 1
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "source_revision",
        "build_digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "type": "string",
          "minLength": 1
        },
        "build_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "command_argv": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "input_schema_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "output_schema_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "READ_ONLY",
          "REPLAY",
          "PAPER"
        ]
      }
    },
    "effect_classes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 1
    },
    "resource_keys": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "qualification_state": {
      "enum": [
        "GAP",
        "CANDIDATE",
        "QUALIFIED",
        "STALE"
      ]
    },
    "qualification_receipts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "handler_id",
    "identity",
    "owner",
    "command_argv",
    "input_schema_digest",
    "output_schema_digest",
    "modes",
    "effect_classes",
    "timeout_ms",
    "resource_keys",
    "qualification_state",
    "qualification_receipts"
  ]
}
