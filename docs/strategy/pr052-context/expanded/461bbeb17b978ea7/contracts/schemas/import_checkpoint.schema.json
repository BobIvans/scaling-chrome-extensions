{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sce:proposal:import_checkpoint:v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "sce.import-checkpoint.proposal.v1"
    },
    "operation_id": {
      "type": "string",
      "minLength": 1
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scope": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "project_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "namespace",
        "profile_id",
        "project_ids"
      ],
      "additionalProperties": false
    },
    "input_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "adapter_id": {
      "type": "string",
      "minLength": 1
    },
    "adapter_version": {
      "type": "string",
      "minLength": 1
    },
    "options_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "cursor": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    "confirmed_objects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "sha256",
          "size"
        ],
        "additionalProperties": false
      }
    },
    "fencing_token": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "RUNNING",
        "PAUSED",
        "CANCELLED",
        "SOURCE_DRIFT",
        "RECOVERY_REQUIRED",
        "COMPLETED"
      ]
    }
  },
  "required": [
    "schema",
    "operation_id",
    "request_sha256",
    "scope",
    "input_fingerprint",
    "adapter_id",
    "adapter_version",
    "options_sha256",
    "cursor",
    "confirmed_objects",
    "fencing_token",
    "state"
  ],
  "additionalProperties": false
}
