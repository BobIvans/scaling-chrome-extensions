{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sce:proposal:source_address:v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "sce.source-address.proposal.v1"
    },
    "scope": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "project_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "namespace",
        "profile_id",
        "project_ids"
      ],
      "additionalProperties": false
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "original_revision_id": {
      "type": "string",
      "minLength": 1
    },
    "raw_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "raw_size": {
      "type": "integer",
      "minimum": 0
    },
    "coordinate": {
      "type": "string",
      "enum": [
        "RAW_BYTES",
        "DERIVED_UTF8_BYTES",
        "JSON_POINTER",
        "LINE_ONLY"
      ]
    },
    "start": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "end": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "range_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "extraction_revision_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "locator": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "mapping_quality": {
      "type": "string",
      "enum": [
        "EXACT",
        "MULTI_RANGE",
        "SEMANTIC_ONLY",
        "LINE_ONLY",
        "UNKNOWN"
      ]
    }
  },
  "required": [
    "schema",
    "scope",
    "source_id",
    "original_revision_id",
    "raw_sha256",
    "raw_size",
    "coordinate",
    "start",
    "end",
    "range_sha256",
    "extraction_revision_id",
    "locator",
    "mapping_quality"
  ],
  "additionalProperties": false
}
