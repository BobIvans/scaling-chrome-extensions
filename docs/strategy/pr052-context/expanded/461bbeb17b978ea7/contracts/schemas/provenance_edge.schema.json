{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sce:proposal:provenance_edge:v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "sce.provenance-edge.proposal.v1"
    },
    "edge_id": {
      "type": "string",
      "minLength": 1
    },
    "graph_revision": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "project_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "namespace",
        "profile_id",
        "project_ids"
      ],
      "additionalProperties": false
    },
    "from_source_id": {
      "type": "string",
      "minLength": 1
    },
    "to_source_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "source_anchor": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "sce.source-address.proposal.v1"
        },
        "scope": {
          "type": "object",
          "properties": {
            "namespace": {
              "type": "string",
              "minLength": 1
            },
            "profile_id": {
              "type": "string",
              "minLength": 1
            },
            "project_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "namespace",
            "profile_id",
            "project_ids"
          ],
          "additionalProperties": false
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "original_revision_id": {
          "type": "string",
          "minLength": 1
        },
        "raw_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "raw_size": {
          "type": "integer",
          "minimum": 0
        },
        "coordinate": {
          "type": "string",
          "enum": [
            "RAW_BYTES",
            "DERIVED_UTF8_BYTES",
            "JSON_POINTER",
            "LINE_ONLY"
          ]
        },
        "start": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "end": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "range_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "extraction_revision_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "locator": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "mapping_quality": {
          "type": "string",
          "enum": [
            "EXACT",
            "MULTI_RANGE",
            "SEMANTIC_ONLY",
            "LINE_ONLY",
            "UNKNOWN"
          ]
        }
      },
      "required": [
        "schema",
        "scope",
        "source_id",
        "original_revision_id",
        "raw_sha256",
        "raw_size",
        "coordinate",
        "start",
        "end",
        "range_sha256",
        "extraction_revision_id",
        "locator",
        "mapping_quality"
      ],
      "additionalProperties": false
    },
    "language": {
      "type": "string",
      "enum": [
        "PYTHON",
        "JS",
        "TS",
        "MIXED",
        "UNKNOWN"
      ]
    },
    "relation_type": {
      "type": "string",
      "enum": [
        "STATIC_IMPORT",
        "TYPE_ONLY_IMPORT",
        "DECLARED_CONTRACT",
        "HEURISTIC_TEST",
        "OWNER_MAPPING",
        "OBSERVED_COVERAGE"
      ]
    },
    "evidence_class": {
      "type": "string",
      "enum": [
        "STATIC",
        "DECLARED",
        "HEURISTIC",
        "OBSERVED"
      ]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "RESOLVED_LOCAL",
        "EXTERNAL",
        "DYNAMIC",
        "AMBIGUOUS",
        "MISSING",
        "UNSUPPORTED",
        "PARSE_FAILED",
        "INELIGIBLE",
        "STALE",
        "RESOURCE_BLOCKED"
      ]
    },
    "rule_id": {
      "type": "string",
      "minLength": 1
    },
    "parser_version": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "resolver_version": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "original_dialect": {
      "type": "string",
      "minLength": 1
    },
    "original_record_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "candidate_targets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema",
    "edge_id",
    "graph_revision",
    "scope",
    "from_source_id",
    "to_source_id",
    "source_anchor",
    "language",
    "relation_type",
    "evidence_class",
    "outcome",
    "rule_id",
    "parser_version",
    "resolver_version",
    "config_sha256",
    "original_dialect",
    "original_record_sha256",
    "reason",
    "candidate_targets"
  ],
  "additionalProperties": false
}
