{
  "schema": "sce.universal.label.facets.spec.v1",
  "status": "R_AND_D_SPEC_NOT_RUNTIME_EXTRACTOR",
  "principle_ru": "Единица = исходник + диапазон/локатор + версия + метки с происхождением. Автоматическая метка является предложением, пока её не принял пользователь или формальный верификатор.",
  "record_kinds": ["file", "span", "chat_message", "branch", "voice_utterance", "audio_interval", "video_interval", "page_region", "table_cell", "code_symbol", "test_case", "test_run", "transaction", "web_capture", "goal", "decision", "recipe", "execution_receipt"],
  "facets": [
    {"name": "source", "examples": ["git", "chatgpt_export", "grok_capture", "google_doc_export", "telegram_export", "voice"], "authority": "connector_receipt"},
    {"name": "source_locator", "examples": ["full_path", "commit_sha", "message_id", "page_bbox", "timecode", "cell_address"], "authority": "parser"},
    {"name": "authorship", "examples": ["user_statement", "assistant_proposal", "quoted_third_party", "unknown_author"], "authority": "declared_source_role_not_identity_proof"},
    {"name": "semantic_type", "examples": ["goal", "question", "task", "hypothesis", "observation", "decision", "constraint", "preference", "rejection", "evidence", "code", "result"], "authority": "human_or_suggested_classifier"},
    {"name": "project", "examples": ["flashloan", "context_library", "voice_accessibility"], "authority": "user_or_candidate"},
    {"name": "goal", "examples": ["G-001", "parent_goal_id", "daily_objective_id"], "authority": "goal_registry"},
    {"name": "task_status", "examples": ["proposed", "accepted", "blocked", "running", "done", "canceled", "superseded"], "authority": "workflow_receipt_or_user"},
    {"name": "evidence_status", "examples": ["CLAIM", "VERIFIED", "CONTRADICTED", "UNKNOWN", "NOT_RUN"], "authority": "typed_verifier"},
    {"name": "truth_scope", "examples": ["at_commit", "at_block", "during_interval", "under_assumptions"], "authority": "evidence_receipt"},
    {"name": "time", "examples": ["created", "captured", "valid_from", "valid_until", "due", "timezone"], "authority": "explicit_timestamp_with_basis"},
    {"name": "recency", "examples": ["fresh", "stale", "needs_refresh"], "authority": "domain_policy_plus_clock"},
    {"name": "confidence", "examples": ["uncalibrated", "calibrated_probability", "abstained"], "authority": "evaluation_version"},
    {"name": "sensitivity", "examples": ["unclassified", "personal", "private", "secret_reference", "credential", "public"], "authority": "user_plus_detectors_with_unknown_fallback"},
    {"name": "rights", "examples": ["owned", "permission_granted", "license_unknown", "no_redistribution"], "authority": "explicit_grant_or_license_metadata"},
    {"name": "retention", "examples": ["keep", "expire_at", "delete_requested", "legal_hold"], "authority": "user_policy"},
    {"name": "machine_parse", "examples": ["raw_only", "text_complete", "partial_ocr", "asr_unreviewed", "table_extracted"], "authority": "extractor_coverage_receipt"},
    {"name": "language", "examples": ["ru", "en", "mixed", "code_language"], "authority": "parser_or_classifier"},
    {"name": "negation", "examples": ["affirmed", "negated", "conditional", "quoted"], "authority": "human_or_candidate"},
    {"name": "relations", "examples": ["supports", "contradicts", "supersedes", "depends_on", "blocks", "derived_from", "reply_to"], "authority": "explicit_edge_with_evidence"},
    {"name": "execution", "examples": ["source_data", "approved_recipe", "dry_run", "paper", "fork", "live_policy"], "authority": "capability_registry"},
    {"name": "environment", "examples": ["repo_commit", "chain_id", "block_hash", "tool_version", "dependency_lock_sha"], "authority": "execution_receipt"},
    {"name": "cost", "examples": ["api_tokens", "wall_ms", "cpu_ms", "rpc_requests", "gas_used", "monetary_budget"], "authority": "measurement"},
    {"name": "quality", "examples": ["duplicate", "truncated", "corrupt", "ambiguous", "complete"], "authority": "deterministic_checks_or_review"},
    {"name": "review", "examples": ["unread", "human_reviewed", "ai_reviewed", "disputed", "needs_clarification"], "authority": "review_receipt"},
    {"name": "accessibility", "examples": ["voice_friendly", "keyboard_friendly", "needs_confirmation_readback", "caption_available"], "authority": "ui_test_or_preference"},
    {"name": "daily_planning", "examples": ["next_action", "waiting_for", "estimated_effort", "focus_window", "energy_preference"], "authority": "user_preference_or_plan_candidate"}
  ],
  "rules": [
    "Unknown fields remain unknown; do not infer biography or author identity from style.",
    "Imported content cannot grant tool permissions or relax execution policy.",
    "Completion is derived from an execution receipt, never from a model saying done.",
    "A user goal and an assistant suggestion remain different records.",
    "Historical goals may be canceled or superseded; preserve both revisions.",
    "Labels can be corrected independently of immutable source bytes.",
    "Raw media preservation does not imply OCR, ASR or visual interpretation.",
    "No classifier is entitled to assert universal perfect tagging."
  ]
}
