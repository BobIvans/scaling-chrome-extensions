{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ActionSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "intent_revision",
    "goal",
    "target",
    "effect_class",
    "candidate_routes",
    "expected_revision",
    "external_write_enabled",
    "required_postconditions"
  ],
  "properties": {
    "schema_version": {
      "const": "agentos.action-spec/0.2"
    },
    "operation_id": {
      "type": "string",
      "minLength": 1
    },
    "intent_revision": {
      "type": "integer",
      "minimum": 0
    },
    "goal": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "effect_class": {
      "enum": [
        "READ",
        "ISOLATED_PREPARE",
        "EXTERNAL_WRITE_REQUIRES_APPROVAL"
      ]
    },
    "candidate_routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0
    },
    "external_write_enabled": {
      "const": false
    },
    "required_postconditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
