{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sce:proposed:ai_result:1",
  "title": "Proposed ai_result v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "namespace": {
      "type": "string",
      "minLength": 1
    },
    "result_id": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "packet_id": {
      "type": "string",
      "minLength": 1
    },
    "packet_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "projection_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "criteria_revision": {
      "type": "string",
      "minLength": 1
    },
    "result_kind": {
      "type": "string",
      "enum": [
        "PATCH_PROPOSAL",
        "RESEARCH_RESULT",
        "NEED_CONTEXT",
        "BLOCKED"
      ]
    },
    "raw_artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterion_id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "namespace": {
                  "type": "string",
                  "minLength": 1
                },
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "revision_id": {
                  "type": "string",
                  "minLength": 1
                },
                "blob_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "offset_space": {
                  "type": "string",
                  "enum": [
                    "raw_bytes",
                    "derived_utf8_bytes"
                  ]
                },
                "start": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "end": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "namespace",
                "source_id",
                "revision_id",
                "blob_sha256",
                "offset_space",
                "start",
                "end"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "evidence_kind": {
            "type": "string",
            "enum": [
              "AI_CLAIM"
            ]
          },
          "verification_state": {
            "type": "string",
            "enum": [
              "UNKNOWN"
            ]
          }
        },
        "required": [
          "criterion_id",
          "statement",
          "citations",
          "evidence_kind",
          "verification_state"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "commands_are_data": {
      "type": "boolean",
      "enum": [
        true
      ]
    }
  },
  "required": [
    "schema_version",
    "namespace",
    "result_id",
    "request_id",
    "task_id",
    "packet_id",
    "packet_digest",
    "projection_digest",
    "criteria_revision",
    "result_kind",
    "raw_artifact_sha256",
    "claims",
    "artifact_refs",
    "gaps",
    "commands_are_data"
  ],
  "additionalProperties": false
}
