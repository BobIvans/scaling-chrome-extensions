{
  "schema_version": "1.0",
  "id": "PIPE-W04",
  "name_ru": "Параллельная миссия с foreground arbitration",
  "mode": "SPEC_ONLY",
  "dispatch_allowed": false,
  "function_ids": [
    "PIPE-06",
    "PIPE-07",
    "PIPE-16",
    "PIPE-17"
  ],
  "requires_implementation": [
    "typed_handler_registry",
    "policy_broker",
    "receipt_store",
    "dag_scheduler"
  ],
  "steps": [
    {
      "id": "validate",
      "operation": "scheduler.validate_acyclic_graph",
      "depends_on": [],
      "resource_locks": [],
      "mutates_external_state": false,
      "retry_policy": "bounded_retry_with_checkpoint",
      "idempotency_key": "${mission.id}:${step.id}:${inputs.sha256}",
      "verification": "receipt.outputs_match_declared_hashes",
      "on_failure": "checkpoint_and_report",
      "status": "NOT_RUN"
    },
    {
      "id": "budget",
      "operation": "scheduler.reserve_resources",
      "depends_on": [
        "validate"
      ],
      "resource_locks": [],
      "mutates_external_state": false,
      "retry_policy": "bounded_retry_with_checkpoint",
      "idempotency_key": "${mission.id}:${step.id}:${inputs.sha256}",
      "verification": "receipt.outputs_match_declared_hashes",
      "on_failure": "checkpoint_and_report",
      "status": "NOT_RUN"
    },
    {
      "id": "reads",
      "operation": "scheduler.dispatch_independent_reads",
      "depends_on": [
        "budget"
      ],
      "resource_locks": [],
      "mutates_external_state": false,
      "retry_policy": "bounded_retry_with_checkpoint",
      "idempotency_key": "${mission.id}:${step.id}:${inputs.sha256}",
      "verification": "receipt.outputs_match_declared_hashes",
      "on_failure": "checkpoint_and_report",
      "status": "NOT_RUN"
    },
    {
      "id": "tests",
      "operation": "scheduler.dispatch_isolated_tests",
      "depends_on": [
        "budget"
      ],
      "resource_locks": [],
      "mutates_external_state": false,
      "retry_policy": "bounded_retry_with_checkpoint",
      "idempotency_key": "${mission.id}:${step.id}:${inputs.sha256}",
      "verification": "receipt.outputs_match_declared_hashes",
      "on_failure": "checkpoint_and_report",
      "status": "NOT_RUN"
    },
    {
      "id": "focus",
      "operation": "desktop.acquire_foreground_lease",
      "depends_on": [
        "budget"
      ],
      "resource_locks": [
        "desktop_foreground"
      ],
      "mutates_external_state": false,
      "retry_policy": "bounded_retry_with_checkpoint",
      "idempotency_key": "${mission.id}:${step.id}:${inputs.sha256}",
      "verification": "receipt.outputs_match_declared_hashes",
      "on_failure": "checkpoint_and_report",
      "status": "NOT_RUN"
    },
    {
      "id": "ui",
      "operation": "desktop.execute_semantic_action",
      "depends_on": [
        "focus"
      ],
      "resource_locks": [
        "desktop_foreground",
        "browser_context:${context.id}"
      ],
      "mutates_external_state": true,
      "retry_policy": "reconcile_before_retry",
      "idempotency_key": "${mission.id}:${step.id}:${inputs.sha256}",
      "verification": "receipt.outputs_match_declared_hashes",
      "on_failure": "checkpoint_and_report",
      "status": "NOT_RUN"
    },
    {
      "id": "join",
      "operation": "scheduler.join_receipts",
      "depends_on": [
        "reads",
        "tests",
        "ui"
      ],
      "resource_locks": [],
      "mutates_external_state": false,
      "retry_policy": "bounded_retry_with_checkpoint",
      "idempotency_key": "${mission.id}:${step.id}:${inputs.sha256}",
      "verification": "receipt.outputs_match_declared_hashes",
      "on_failure": "checkpoint_and_report",
      "status": "NOT_RUN"
    },
    {
      "id": "verify",
      "operation": "verifier.evaluate_actual_outcomes",
      "depends_on": [
        "join"
      ],
      "resource_locks": [],
      "mutates_external_state": false,
      "retry_policy": "bounded_retry_with_checkpoint",
      "idempotency_key": "${mission.id}:${step.id}:${inputs.sha256}",
      "verification": "receipt.outputs_match_declared_hashes",
      "on_failure": "checkpoint_and_report",
      "status": "NOT_RUN"
    }
  ],
  "invariants": [
    "User activity pauses foreground lane.",
    "STOP bypasses cloud planning and blocks new mutation dispatch.",
    "Concurrent writes require distinct isolated state; browser profile shared state still locks.",
    "Timers/resources pause queue; they do not silently truncate source coverage."
  ],
  "result_statuses": [
    "TRUE",
    "FALSE",
    "UNKNOWN",
    "NOT_RUN"
  ]
}
