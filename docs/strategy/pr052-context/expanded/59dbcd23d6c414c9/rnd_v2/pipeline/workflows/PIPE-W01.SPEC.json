{
  "schema_version": "1.0",
  "id": "PIPE-W01",
  "name_ru": "Голос → подтверждённая миссия → контекст",
  "mode": "SPEC_ONLY",
  "dispatch_allowed": false,
  "function_ids": [
    "PIPE-01",
    "PIPE-02",
    "PIPE-03",
    "PIPE-05"
  ],
  "requires_implementation": [
    "typed_handler_registry",
    "policy_broker",
    "receipt_store",
    "dag_scheduler"
  ],
  "steps": [
    {
      "id": "audio",
      "operation": "voice.capture",
      "depends_on": [],
      "resource_locks": [],
      "mutates_external_state": false,
      "retry_policy": "bounded_retry_with_checkpoint",
      "idempotency_key": "${mission.id}:${step.id}:${inputs.sha256}",
      "verification": "receipt.outputs_match_declared_hashes",
      "on_failure": "checkpoint_and_report",
      "status": "NOT_RUN"
    },
    {
      "id": "transcript",
      "operation": "voice.transcribe",
      "depends_on": [
        "audio"
      ],
      "resource_locks": [],
      "mutates_external_state": false,
      "retry_policy": "bounded_retry_with_checkpoint",
      "idempotency_key": "${mission.id}:${step.id}:${inputs.sha256}",
      "verification": "receipt.outputs_match_declared_hashes",
      "on_failure": "checkpoint_and_report",
      "status": "NOT_RUN"
    },
    {
      "id": "prefetch",
      "operation": "context.prefetch_readonly",
      "depends_on": [
        "transcript"
      ],
      "resource_locks": [],
      "mutates_external_state": false,
      "retry_policy": "bounded_retry_with_checkpoint",
      "idempotency_key": "${mission.id}:${step.id}:${inputs.sha256}",
      "verification": "receipt.outputs_match_declared_hashes",
      "on_failure": "checkpoint_and_report",
      "status": "NOT_RUN"
    },
    {
      "id": "commit",
      "operation": "mission.commit_transcript",
      "depends_on": [
        "transcript"
      ],
      "resource_locks": [],
      "mutates_external_state": false,
      "retry_policy": "bounded_retry_with_checkpoint",
      "idempotency_key": "${mission.id}:${step.id}:${inputs.sha256}",
      "verification": "receipt.outputs_match_declared_hashes",
      "on_failure": "checkpoint_and_report",
      "status": "NOT_RUN"
    },
    {
      "id": "route",
      "operation": "router.select_known_recipe",
      "depends_on": [
        "commit"
      ],
      "resource_locks": [],
      "mutates_external_state": false,
      "retry_policy": "bounded_retry_with_checkpoint",
      "idempotency_key": "${mission.id}:${step.id}:${inputs.sha256}",
      "verification": "receipt.outputs_match_declared_hashes",
      "on_failure": "checkpoint_and_report",
      "status": "NOT_RUN"
    },
    {
      "id": "context",
      "operation": "context.resolve_with_coverage",
      "depends_on": [
        "prefetch",
        "commit",
        "route"
      ],
      "resource_locks": [],
      "mutates_external_state": false,
      "retry_policy": "bounded_retry_with_checkpoint",
      "idempotency_key": "${mission.id}:${step.id}:${inputs.sha256}",
      "verification": "receipt.outputs_match_declared_hashes",
      "on_failure": "checkpoint_and_report",
      "status": "NOT_RUN"
    },
    {
      "id": "mission",
      "operation": "mission.compile_validate",
      "depends_on": [
        "context"
      ],
      "resource_locks": [],
      "mutates_external_state": false,
      "retry_policy": "bounded_retry_with_checkpoint",
      "idempotency_key": "${mission.id}:${step.id}:${inputs.sha256}",
      "verification": "mission.schema_valid AND every_context_ref_resolvable",
      "on_failure": "checkpoint_and_report",
      "status": "NOT_RUN"
    }
  ],
  "invariants": [
    "Changing actions depend on transcript commit.",
    "Unknown route abstains; cached labels are not authorization.",
    "Original audio retention follows explicit local setting."
  ],
  "result_statuses": [
    "TRUE",
    "FALSE",
    "UNKNOWN",
    "NOT_RUN"
  ]
}
