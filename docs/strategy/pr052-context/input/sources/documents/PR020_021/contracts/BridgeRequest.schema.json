{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sce-studious:proposed:BridgeRequest:v1",
  "title": "BridgeRequest proposed v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "handler_id": {
      "type": "string",
      "minLength": 1
    },
    "handler_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "source_revision",
        "build_digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "type": "string",
          "minLength": 1
        },
        "build_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "mode": {
      "enum": [
        "READ_ONLY",
        "REPLAY",
        "PAPER"
      ]
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "dataset_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "config_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "criteria_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "request_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "registry_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "budget_policy_ref": {
      "type": "string",
      "minLength": 1
    },
    "scope_ref": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "attempt_id",
    "handler_id",
    "handler_identity",
    "mode",
    "profile",
    "dataset_digest",
    "config_digest",
    "criteria_digest",
    "request_digest",
    "idempotency_key",
    "registry_digest",
    "budget_policy_ref",
    "scope_ref",
    "created_at"
  ]
}
