{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sce-studious:proposed:Observation:v1",
  "title": "Observation proposed v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "observation_id": {
      "type": "string",
      "minLength": 1
    },
    "raw_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "raw_ref": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "upstream_family_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "adapter_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "source_revision",
        "build_digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "type": "string",
          "minLength": 1
        },
        "build_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "origin": {
      "enum": [
        "OFFLINE_FIXTURE",
        "REAL_ACQUISITION"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "available_at": {
      "type": "string",
      "format": "date-time"
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chain",
        "network",
        "reference",
        "revision",
        "commitment"
      ],
      "properties": {
        "chain": {
          "type": "string",
          "minLength": 1
        },
        "network": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "commitment": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "completeness": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "MISSING"
      ]
    },
    "gap_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cursor": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "observation_id",
    "raw_sha256",
    "raw_ref",
    "provider",
    "upstream_family_ids",
    "adapter_identity",
    "origin",
    "observed_at",
    "received_at",
    "available_at",
    "anchor",
    "completeness",
    "gap_refs",
    "cursor"
  ]
}
