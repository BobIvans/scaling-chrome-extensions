{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sce:proposed:need_context:1",
  "title": "Proposed need_context v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "namespace": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "packet_id": {
      "type": "string",
      "minLength": 1
    },
    "packet_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "criteria_revision": {
      "type": "string",
      "minLength": 1
    },
    "criterion_id": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "requested_source_ref": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "revision_id": {
          "type": "string",
          "minLength": 1
        },
        "blob_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "offset_space": {
          "type": "string",
          "enum": [
            "raw_bytes",
            "derived_utf8_bytes"
          ]
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "end": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "namespace",
        "source_id",
        "revision_id",
        "blob_sha256",
        "offset_space",
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "max_response_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schema_version",
    "namespace",
    "request_id",
    "task_id",
    "packet_id",
    "packet_digest",
    "criteria_revision",
    "criterion_id",
    "reason",
    "requested_source_ref",
    "max_response_bytes"
  ],
  "additionalProperties": false
}
