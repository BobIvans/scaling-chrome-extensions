{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sce:proposed:stop_receipt:1",
  "title": "Proposed stop_receipt v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "namespace": {
      "type": "string",
      "minLength": 1
    },
    "stop_request_id": {
      "type": "string",
      "minLength": 1
    },
    "requested_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "control_ack": {
      "type": "string",
      "enum": [
        "LOCAL_ACCEPTED",
        "DURABLE_FENCED",
        "UNCONFIRMED"
      ]
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "operation_id": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "type": "string",
            "enum": [
              "CANCELLED_BEFORE_DISPATCH",
              "CANCELLATION_REQUESTED",
              "COMPLETED",
              "CANCELLED_OBSERVED",
              "UNKNOWN_EFFECT",
              "UNCONFIRMED"
            ]
          }
        },
        "required": [
          "operation_id",
          "outcome"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "timing_measurement_state": {
      "type": "string",
      "enum": [
        "NOT_RUN",
        "MEASURED"
      ]
    },
    "new_dispatch_allowed": {
      "type": "boolean",
      "enum": [
        false
      ]
    }
  },
  "required": [
    "schema_version",
    "namespace",
    "stop_request_id",
    "requested_epoch",
    "control_ack",
    "observations",
    "timing_measurement_state",
    "new_dispatch_allowed"
  ],
  "additionalProperties": false
}
