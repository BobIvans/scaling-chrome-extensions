{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sce:proposed:task_document:1",
  "title": "Proposed task_document v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "namespace": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "goal_id": {
      "type": "string",
      "minLength": 1
    },
    "goal_revision": {
      "type": "string",
      "minLength": 1
    },
    "criteria_revision": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterion_id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "origin_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "criterion_id",
          "text",
          "origin_ref"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "namespace": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "revision_id": {
            "type": "string",
            "minLength": 1
          },
          "blob_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "offset_space": {
            "type": "string",
            "enum": [
              "raw_bytes",
              "derived_utf8_bytes"
            ]
          },
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "end": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "namespace",
          "source_id",
          "revision_id",
          "blob_sha256",
          "offset_space",
          "start",
          "end"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "omissions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_ref": {
            "type": "object",
            "properties": {
              "namespace": {
                "type": "string",
                "minLength": 1
              },
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "revision_id": {
                "type": "string",
                "minLength": 1
              },
              "blob_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "offset_space": {
                "type": "string",
                "enum": [
                  "raw_bytes",
                  "derived_utf8_bytes"
                ]
              },
              "start": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "end": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "namespace",
              "source_id",
              "revision_id",
              "blob_sha256",
              "offset_space",
              "start",
              "end"
            ],
            "additionalProperties": false
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "next_action": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source_ref",
          "reason",
          "next_action"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "return_contract_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "task_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "namespace",
    "task_id",
    "goal_id",
    "goal_revision",
    "criteria_revision",
    "snapshot_id",
    "requirements",
    "sources",
    "omissions",
    "return_contract_version",
    "task_digest"
  ],
  "additionalProperties": false
}
