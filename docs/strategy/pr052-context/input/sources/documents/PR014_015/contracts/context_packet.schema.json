    "required_next_ranges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_ref": {
            "type": "object",
            "properties": {
              "namespace": {
                "type": "string",
                "minLength": 1
              },
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "revision_id": {
                "type": "string",
                "minLength": 1
              },
              "blob_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "offset_space": {
                "type": "string",
                "enum": [
                  "raw_bytes",
                  "derived_utf8_bytes"
