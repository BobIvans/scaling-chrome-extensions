          "next_action": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source_ref",
          "reason",
          "next_action"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "packet_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "namespace",
    "packet_id",
    "task_id",
    "task_digest",
    "goal_revision",
    "criteria_revision",
    "snapshot_id",
    "sources",
    "parts",
    "required_next_ranges",
    "packet_digest"
  ],
  "additionalProperties": false
}
